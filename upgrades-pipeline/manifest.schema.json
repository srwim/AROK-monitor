{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AROK Hardware Upgrades manifest",
  "type": "object",
  "required": ["version", "generatedAt", "disclosure", "componentUpgrades", "featuredSystems"],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "disclosure": { "type": "string", "minLength": 1 },
    "componentUpgrades": {
      "type": "object",
      "description": "Keyed by component category (cpu, gpu, ram, storage, motherboard, psu, cooler, case). Feeds the rotating carousel.",
      "additionalProperties": {
        "type": "object",
        "required": ["label", "bangForBuck", "highEnd"],
        "properties": {
          "label": { "type": "string" },
          "bangForBuck": { "$ref": "#/$defs/pick" },
          "highEnd": { "$ref": "#/$defs/pick" }
        }
      }
    },
    "featuredSystems": {
      "type": "array",
      "description": "Full builds. Components link to Amazon (tagged) by default; parts Amazon doesn't carry link to another store (plain, untagged) via the component 'store' field. A build with empty components + a 'note' renders as coming soon.",
      "items": {
        "type": "object",
        "required": ["name", "components"],
        "properties": {
          "name": { "type": "string" },
          "source": { "type": "string" },
          "sourceUrl": { "type": "string" },
          "totalPrice": { "type": "string" },
          "note": { "type": "string" },
          "components": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["type", "name", "url"],
              "properties": {
                "type": { "type": "string" },
                "name": { "type": "string" },
                "price": { "type": "string" },
                "qty": { "type": "integer", "minimum": 1, "description": "Quantity of this identical part in the build. Absent means 1. Price stays per-unit; the build total already accounts for quantity." },
                "store": { "type": "string", "description": "Retailer for this link. Absent/'Amazon' = tagged affiliate link; any other value = non-Amazon store, plain link." },
                "image": { "type": "string", "description": "Thumbnail URL. Tier 1 = manually curated; tier 2 = resolved from Open Icecat by brand+MPN in the pipeline; absent = app shows a category icon." },
                "url": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "gpuWatch": {
      "type": "array",
      "description": "Curated watch-list of high-demand GPUs: model, launch-reference MSRP, and a tagged Amazon search link. No live scraping.",
      "items": {
        "type": "object",
        "required": ["model", "url"],
        "properties": {
          "model": { "type": "string" },
          "msrp": { "type": "string" },
          "url": { "type": "string", "pattern": "tag=" }
        }
      }
    }
  },
  "$defs": {
    "pick": {
      "type": "object",
      "required": ["title", "url"],
      "properties": {
        "title": { "type": "string" },
        "asin": { "type": "string" },
        "price": { "type": "string" },
        "image": { "type": "string" },
        "url": { "type": "string", "pattern": "tag=" }
      }
    }
  }
}
