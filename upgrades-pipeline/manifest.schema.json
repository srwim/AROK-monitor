{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AROK Hardware Upgrades manifest",
  "type": "object",
  "required": ["version", "generatedAt", "disclosure", "componentUpgrades", "featuredSystems"],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "disclosure": { "type": "string", "minLength": 1 },
    "componentUpgrades": {
      "type": "object",
      "description": "Keyed by component category (cpu, gpu, ram, storage, motherboard, psu, cooler, case). Feeds the rotating carousel.",
      "additionalProperties": {
        "type": "object",
        "required": ["label", "bangForBuck", "highEnd"],
        "properties": {
          "label": { "type": "string" },
          "bangForBuck": { "$ref": "#/$defs/pick" },
          "highEnd": { "$ref": "#/$defs/pick" }
        }
      }
    },
    "featuredSystems": {
      "type": "array",
      "description": "Full builds (best-effort from PCPartPicker featured), components cross-referenced to Amazon.",
      "items": {
        "type": "object",
        "required": ["name", "components"],
        "properties": {
          "name": { "type": "string" },
          "source": { "type": "string" },
          "sourceUrl": { "type": "string" },
          "totalPrice": { "type": "string" },
          "components": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["type", "name", "url"],
              "properties": {
                "type": { "type": "string" },
                "name": { "type": "string" },
                "url": { "type": "string", "pattern": "tag=" }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "pick": {
      "type": "object",
      "required": ["title", "url"],
      "properties": {
        "title": { "type": "string" },
        "asin": { "type": "string" },
        "price": { "type": "string" },
        "image": { "type": "string" },
        "url": { "type": "string", "pattern": "tag=" }
      }
    }
  }
}
